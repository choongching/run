# Supabase
NEXT_PUBLIC_SUPABASE_URL=placeholder
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=placeholder
SUPABASE_SERVICE_ROLE_KEY=placeholder

# Anthropic
ANTHROPIC_API_KEY=placeholder

# Pipedream Connect
PIPEDREAM_PROJECT_ID=placeholder
PIPEDREAM_CLIENT_ID=placeholder
PIPEDREAM_CLIENT_SECRET=placeholder
PIPEDREAM_ENVIRONMENT=development

# Web search. BRAVE_API_KEY is the platform key every user's searches run on
# until they connect their own account. SEARCH_TOOL_USER_IDS is a temporary
# staged-rollout list (comma separated user ids); unset means nobody gets the
# new search tool and everyone keeps Anthropic's built-in one.
BRAVE_API_KEY=placeholder
SEARCH_TOOL_USER_IDS=

# App
NEXT_PUBLIC_APP_NAME=Run
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret the pg_cron tick presents to /api/routines/tick.
# Generate any long random string; set the same value in the cron job.
ROUTINES_CRON_SECRET=
