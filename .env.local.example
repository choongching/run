# Supabase
NEXT_PUBLIC_SUPABASE_URL=placeholder
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=placeholder
SUPABASE_SERVICE_ROLE_KEY=placeholder

# Anthropic
ANTHROPIC_API_KEY=placeholder

# Pipedream Connect
PIPEDREAM_PROJECT_ID=placeholder
PIPEDREAM_CLIENT_ID=placeholder
PIPEDREAM_CLIENT_SECRET=placeholder
PIPEDREAM_ENVIRONMENT=development

# Web search. The platform key every user's searches run on until they connect
# their own account. Its presence is also the switch: set it and agents search
# through our provider with Anthropic's built-in search turned off; leave it
# unset and they fall back to the built-in one, which works but costs twenty
# times more per search.
BRAVE_API_KEY=placeholder

# App
NEXT_PUBLIC_APP_NAME=Run
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret the pg_cron tick presents to /api/routines/tick.
# Generate any long random string; set the same value in the cron job.
ROUTINES_CRON_SECRET=

# Telegram delivery. Routine reports arrive as messages from your own bot.
# Leave TELEGRAM_BOT_TOKEN unset and the whole feature disappears from the UI
# rather than offering a button that leads nowhere.
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Echoed back by Telegram on every webhook call, in the
# X-Telegram-Bot-Api-Secret-Token header. You give this value to Telegram when
# you register the webhook, so THEY HOLD A COPY OF IT.
TELEGRAM_WEBHOOK_SECRET=

# Signs the short-lived pairing token that binds a Telegram chat to an account.
# THREE DIFFERENT VALUES, and this one must not equal the webhook secret above:
# that one is shared with Telegram, and a key someone else holds cannot also be
# the key that vouches for who pressed the button in Run. Generate with
# `openssl rand -hex 32`.
TELEGRAM_PAIRING_SECRET=
